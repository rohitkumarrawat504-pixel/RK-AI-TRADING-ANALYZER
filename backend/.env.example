from __future__ import annotations

import os


class Config:
    def __init__(self) -> None:
        self.app_name = os.getenv("APP_NAME", "RK-AI-TRADING-ANALYZER")
        self.app_env = os.getenv("APP_ENV", "development")
        self.debug = os.getenv("DEBUG", "true").lower() == "true"
        self.host = os.getenv("HOST", "0.0.0.0")
        self.port = int(os.getenv("PORT", "8000"))
        self.cors_origins = [item.strip() for item in os.getenv("CORS_ORIGINS", "http://localhost:5173,http://localhost:3000").split(",") if item.strip()]
        self.data_provider = os.getenv("DATA_PROVIDER", "coingecko")
        self.default_market = os.getenv("DEFAULT_MARKET", "BTC-USD")
        self.default_timeframe = os.getenv("DEFAULT_TIMEFRAME", "15m")
        self.rate_limit_per_minute = int(os.getenv("RATE_LIMIT_PER_MINUTE", "60"))
        self.coingecko_base_url = os.getenv("COINGECKO_BASE_URL", "https://api.coingecko.com/api/v3")
        self.exchange_api_key = os.getenv("EXCHANGE_API_KEY", "")
        self.exchange_api_secret = os.getenv("EXCHANGE_API_SECRET", "")


settings = Config()
